msgstr "Gateway ID"

msgctxt "Languages::cardlink.gateway_id_tip"
msgid "Required for Google Pay and Apple Pay integrations."
msgstr "Απαραίτητο για τη διασύνδεση με Google Pay και Apple Pay."

