msgctxt "Languages::cardlink.refund_amount"
msgid "Refund Amount"
msgstr "Ποσό επιστροφής"

msgctxt "Languages::cardlink.execute_refund"
msgid "Execute Refund"
msgstr "Εκτέλεση επιστροφής"

msgctxt "Languages::cardlink.action_refund_failed"
msgid "Refund failed. Please check the transaction status."
msgstr "Η επιστροφή χρημάτων απέτυχε. Παρακαλούμε ελέγξτε την κατάσταση της συναλλαγής."

msgctxt "Languages::cardlink.action_refund_success"
msgid "Refund processed successfully."
msgstr "Η επιστροφή χρημάτων ολοκληρώθηκε με επιτυχία."

msgctxt "Languages::cardlink.action_capture_failed"
msgid "Capture failed. The transaction might have expired or was already settled."
msgstr "Η οριστικοποίηση πληρωμής (Capture) απέτυχε. Η συναλλαγή ενδέχεται να έχει λήξει ή να έχει ήδη εκκαθαριστεί."

msgctxt "Languages::cardlink.action_capture_success"
msgid "Payment captured successfully."
msgstr "Η οριστικοποίηση της πληρωμής ολοκληρώθηκε με επιτυχία."

msgctxt "Languages::cardlink.action_void_failed"
msgid "Void transaction failed. Please check the details in the Cardlink Portal or try again."
msgstr "Η ακύρωση της συναλλαγής (Void) απέτυχε. Παρακαλούμε ελέγξτε τις λεπτομέρειες στο Cardlink Portal ή δοκιμάστε ξανά."

msgctxt "Languages::cardlink.action_void_success"
msgid "Transaction voided successfully."
msgstr "Η ακύρωση της συναλλαγής ολοκληρώθηκε με επιτυχία."

