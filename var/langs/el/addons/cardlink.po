msgid "Refund not available yet"
msgstr "Η επιστροφή δεν είναι διαθέσιμη ακόμη"

msgctxt "Languages::cardlink.void_not_available"
msgid "Captures have already been made. Cancellation is not possible. Please wait for clearance to make a Refund."
msgstr "Έχουν ήδη πραγματοποιηθεί εισπράξεις (Captures). Η ακύρωση δεν είναι δυνατή. Παρακαλούμε περιμένετε την εκκαθάριση για να κάνετε επιστροφή (Refund)."

msgctxt "Languages::cardlink.capture_remaining"
msgid "Capture remaining amount"
msgstr "Οριστικοποίηση υπολειπόμενου ποσού"

msgctxt "Languages::cardlink.transaction_failed"
msgid "Transaction Failed"
msgstr "Η συναλλαγή απέτυχε"

msgctxt "Languages::cardlink.action_cancel_success"
msgid "Cancel Success"
msgstr "Επιτυχημένη ακύρωση"

msgctxt "Languages::cardlink.transaction_closed"
msgid "Transaction closed"
msgstr "Η συναλλαγή έχει κλείσει"

msgctxt "Languages::cardlink.background_confirmation_url"
msgid "Background confirmation URL"
msgstr "URL επιβεβαίωσης background"

msgctxt "Languages::cardlink.background_confirmation_tip"
msgid "Use this URL in Cardlink''s back-office as the server-to-server confirmation endpoint."
msgstr "Χρησιμοποιήστε αυτό το URL στο back-office της Cardlink ως server-to-server endpoint επιβεβαίωσης."

msgctxt "Languages::cardlink.use_transaction_history_actions"
msgid "Use the transaction history actions below"
msgstr "Χρησιμοποιήστε τις ενέργειες του ιστορικού συναλλαγών παρακάτω"

msgctxt "Languages::cardlink.max_row_action_amount"
msgid "Maximum available amount"
msgstr "Μέγιστο διαθέσιμο ποσό"

msgctxt "Languages::cardlink.invalid_action_amount"
msgid "The requested amount is not valid for the selected Cardlink transaction."
msgstr "Το ζητούμενο ποσό δεν είναι έγκυρο για την επιλεγμένη συναλλαγή Cardlink."

msgctxt "Languages::cardlink.no_available_transaction_action"
msgid "No Cardlink transaction is currently available for this action."
msgstr "Δεν υπάρχει διαθέσιμη συναλλαγή Cardlink για αυτή την ενέργεια."

msgctxt "Languages::cardlink.status_refresh_failed"
msgid "Cardlink status refresh failed. Please try again."
msgstr "Η ανανέωση κατάστασης από την Cardlink απέτυχε. Δοκιμάστε ξανά."

